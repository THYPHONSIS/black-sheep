{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Black sheep",
  "version": "0.2.0",
  "identifier": "io.github.thyphonsis.blacksheep",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Black sheep", "width": 1440, "height": 1000, "minWidth": 760, "minHeight": 640}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.crossref.org; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../../../LICENSE", "../../../THIRD_PARTY_NOTICES.md"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
