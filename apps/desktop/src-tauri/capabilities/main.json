{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-document-dialogs",
  "description": "Read/write only files explicitly selected in native open/save dialogs. No global directory scope.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {"identifier": "opener:allow-open-url", "allow": [{"url": "https://doi.org/*"}]}
  ]
}
