{
  "name": "black-sheep-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @black-sheep/desktop dev",
    "build": "pnpm --filter @black-sheep/desktop build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "notices": "node scripts/collect-notices.mjs",
    "quality": "pnpm notices && pnpm test && pnpm build",
    "check": "pnpm quality",
    "testversion:build": "pnpm notices && pnpm --filter @black-sheep/desktop build:standalone && node scripts/seal-standalone.mjs",
    "desktop:dev": "pnpm --filter @black-sheep/desktop tauri dev",
    "desktop:build": "pnpm --filter @black-sheep/desktop tauri build",
    "desktop:bundle-check": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT"
}
